      notify('Chưa kết nối kho bản dịch. Website vẫn hiển thị tiếng Việt.');
      return;
    }
    var controller = new AbortController();
    requestController = controller;
    var timer = setTimeout(function(){controller.abort();}, 8000);
    var pack;
    try { pack = activePack && activePack.route === route() ? activePack : await getPack(controller.signal); }
    finally { clearTimeout(timer); }
    if (sequence !== run) return;
    activePack = pack;
    var result = getTranslations(pack,list,target);
    lastIncompleteKeys = result.missing;
    if (!result.covered) {
      if (select) { select.value = 'vi'; syncLanguageMenu(); }
      notify('Trang này chưa có nội dung dịch sang ' + LANGS[target] + '. Website vẫn ở tiếng Việt.');
      return;
    }
    if (!putTranslations(list,result.values,target)) {
      restore();
      if (select) { select.value = 'vi'; syncLanguageMenu(); }
      notify('Trang vừa cập nhật nội dung khi dịch. Vui lòng chọn ngôn ngữ lại.');
