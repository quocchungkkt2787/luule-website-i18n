  function syncLanguageMenu() {
    if (!langTrigger || !langMenu) return;
    var code = (select && LANG_LABELS[select.value]) ? select.value : 'vi';
    langTrigger.querySelector('.ll-lang-current-flag').innerHTML = FLAG_SVGS[code];
    var roundFlagSvg = langTrigger.querySelector('.ll-lang-current-flag svg');
    if (roundFlagSvg) roundFlagSvg.setAttribute('preserveAspectRatio','xMidYMid slice');
    langTrigger.querySelector('.ll-lang-current-label').textContent = LANG_LABELS[code].label;
    langMenu.querySelectorAll('button[data-lang]').forEach(function(button) {
      var active = button.getAttribute('data-lang') === code;
      button.setAttribute('aria-checked', active ? 'true' : 'false');
    });
    if (mobileTrigger) {
      var mobileFlag = mobileTrigger.querySelector('.ll-mobile-lang-flag');
      var mobileName = mobileTrigger.querySelector('.ll-mobile-lang-name');
      if (mobileFlag) mobileFlag.innerHTML = FLAG_SVGS[code];
      if (mobileName) mobileName.textContent = LANG_LABELS[code].label;
    }
    if (mobileOptions) mobileOptions.querySelectorAll('button[data-lang]').forEach(function(button) {
      button.setAttribute('aria-checked',button.getAttribute('data-lang')===code?'true':'false');
    });
  }
  function closeLanguageMenu(focusTrigger) {
    if (!langMenu || !langTrigger) return;
    langMenu.hidden = true;
    var menuHost=langTrigger.closest('#ll-language-v3');
    if (menuHost) menuHost.classList.remove('ll-lang-menu-open');
    langTrigger.setAttribute('aria-expanded', 'false');
    if (focusTrigger) langTrigger.focus();
  }
  function openLanguageMenu() {
    if (!langMenu || !langTrigger) return;
    langMenu.hidden = false;
    var menuHost=langTrigger.closest('#ll-language-v3');
    if (menuHost) menuHost.classList.add('ll-lang-menu-open');
    langTrigger.setAttribute('aria-expanded', 'true');
    syncLanguageMenu();
    var chosen = langMenu.querySelector('button[aria-checked="true"]');
    if (chosen) chosen.focus();
  }
  function mobileFeedback(message, type) {
    if (!mobileStatus) return;
    mobileStatus.textContent = message || '';
    mobileStatus.hidden = !message;
    mobileStatus.setAttribute('data-state',type || 'info');
  }
  function hideNotice() {
    var el = document.getElementById('ll-language-v3-notice');
    if (el) el.hidden = true;
  }
  function notify(msg) {
    var el = document.getElementById('ll-language-v3-notice');
    if (!el) return;
    el.querySelector('.ll-notice-text').textContent = msg;
    el.hidden = false;
    mobileFeedback(msg,'error');
    clearTimeout(noticeTimer);
    noticeTimer = setTimeout(hideNotice, 6500);
  }
  async function getPack(signal) {
    lastPackError = '';
    if (!/^https:\/\/[^\s/]+(?:\/[^\s]*)?$/i.test(BASE) && !/^\/[^/]/.test(BASE)) {
      lastPackError = 'invalid-base';
      return null;
    }
    var url = BASE + '/i18n/' + routeKey(route()) + '.json';
    try {
      var res = await fetch(url,{mode:'cors',cache:'no-store',signal:signal,credentials:'omit'});
      if (!res.ok) {lastPackError = 'HTTP ' + res.status;return null;}
      var data = await res.json();
      if (!data || data.version !== 3 || data.route !== route() ||
          !data.texts || typeof data.texts !== 'object') {
        lastPackError = 'invalid-pack';
        return null;
      }
      return data;
    } catch (err) {
