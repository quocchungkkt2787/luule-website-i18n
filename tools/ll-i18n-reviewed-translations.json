    [300,1000,2400].forEach(function(ms){setTimeout(function(){scheduleMobileMount(0);},ms);});

    var notice = document.createElement('div'); notice.id='ll-language-v3-notice';notice.hidden=true;
    notice.setAttribute('role','status');notice.setAttribute('data-ll-no-translate','');
    var message=document.createElement('span');message.className='ll-notice-text';
    var close=document.createElement('button');close.type='button';close.textContent='×';close.setAttribute('aria-label','Đóng');close.onclick=hideNotice;
    notice.appendChild(message);notice.appendChild(close);document.body.appendChild(notice);
    var root=document.body;
    observer=new MutationObserver(checkDynamicChanges);
    observer.observe(root,{subtree:true,childList:true,characterData:true,attributes:true,attributeFilter:ATTRIBUTES});
    // Haravan sections can appear after a carousel/slider initializes or when
    // a long page is scrolled. Some third-party widgets do not generate useful
    // observer records; a lightweight reconciliation catches those later nodes.
    window.addEventListener('scroll',function(){
      if (lang === 'vi' || Date.now()-lastScrollAt<1200) return;
      lastScrollAt=Date.now();checkDynamicChanges();
    },{passive:true});
    window.addEventListener('pageshow',function(){if(lang!=='vi')checkDynamicChanges();});
    var warmupScan = setInterval(function(){
      if (lang !== 'vi' && document.visibilityState !== 'hidden' && Date.now()-lastReconcileAt >= 1800) checkDynamicChanges();
    },2500);
    // Stop periodic scanning after startup; MutationObserver and scrolling stay active.
    setTimeout(function(){clearInterval(warmupScan);},30000);
    try{ var saved=localStorage.getItem(PREF_KEY);if(LANGS[saved])desired=saved;}catch(_e){}
    if (desired !== 'vi') changeLanguage(desired,true);
    window.LLGlobalI18N={
      state:function(){return {version:'3.4.2-shipping-dynamic-label-safety',lang:lang,route:route(),base:BASE,packLoaded:!!activePack,packError:lastPackError,untranslatedOnSwitch:lastIncompleteKeys.length,untranslatedDynamicCount:missingDynamic.length};},
      untranslatedDynamic:function(){return missingDynamic.slice();},
      changeLanguage:function(code){return changeLanguage(code,false);},
      reset:function(){return changeLanguage('vi',false);},
      reconcile:function(){checkDynamicChanges();},
      audit:function(){
        var out = new Set();
        if (!activePack || lang==='vi') return [];
        collect().forEach(function(x){if (!translatedFor(activePack,x.key,lang)) out.add(x.key);});
        return Array.from(out);
      }
    };
  }
  if (document.readyState === 'complete') init();
  else window.addEventListener('load',function(){setTimeout(init,150);},{once:true});
})();
