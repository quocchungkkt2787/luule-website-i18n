  function getTranslations(pack,list,target) {
    // A live Haravan page may have new dynamic strings that are absent from
    // the published static JSON. Do NOT reject the entire page for one key.
    // Preserve the original Vietnamese for missing keys; never invent copy.
    var values = [], missing = [], covered = 0;
    for (var i=0; i<list.length; i++) {
      var v = translatedFor(pack,list[i].key,target);
      if (typeof v === 'string' && norm(v)) {
        values.push(v);
        covered++;
      } else {
        values.push(list[i].source);
        missing.push(list[i].key);
      }
    }
    return {values:values,missing:Array.from(new Set(missing)),covered:covered};
  }
  function putTranslations(list,values,target) {
