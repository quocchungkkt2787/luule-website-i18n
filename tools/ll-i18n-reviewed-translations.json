  function checkDynamicChanges() {
    if (applying || lang === 'vi') return;
    clearTimeout(refreshTimer);
    refreshTimer = setTimeout(function() {
      if (applying || lang === 'vi') return;
      var list = collect(), pending = [], values = [], missing = new Set();

      // Inspect only new/changed DOM items. Never reset the whole page just
      // because a carousel, notification or other third-party script updated it.
      list.forEach(function(x) {
        var state = x.type === 'text' ? textOriginal.get(x.node)
          : x.type === 'attribute' ? (attrOriginal.get(x.node) || {})[x.attr]
          : valueOriginal.get(x.node);
        var displayed = x.type === 'text' ? x.node.nodeValue
          : x.type === 'attribute' ? x.node.getAttribute(x.attr) : x.node.value;
        if (state && state.last === displayed) return;

        var tr = translatedFor(activePack,x.key,lang);
        if (typeof tr === 'string' && norm(tr)) {
          pending.push(x);
          values.push(tr);
        } else {
          missing.add(x.key);
        }
      });

      // Translate known dynamic strings without touching existing translations.
      // If the DOM changes while applying, let the next mutation retry safely.
      if (pending.length && !putTranslations(pending,values,lang)) {
        console.warn('[LL I18N] Dynamic DOM changed during translation; a later update will retry.');
      }

      missingDynamic = Array.from(missing);
      lastReconcileAt = Date.now();
      var signature = missingDynamic.slice().sort().join('\u001f');
      if (missingDynamic.length && signature !== lastMissingSignature) {
        console.warn('[LL I18N] Dynamic text missing from translation pack:', missingDynamic.length,
          'Open LLGlobalI18N.untranslatedDynamic() in Console to inspect on this device.');
        // This is a temporary preview compromise: an untranslated dynamic snippet
        // can remain Vietnamese, but the whole page must not unexpectedly reset.
        if (Date.now() - lastDynamicNoticeAt > 30000) {
          notify(lang === 'en'
            ? 'Some newly updated content has no English translation yet. Your language choice is preserved.'
            : '部分新更新的内容尚无中文译文，已保留您选择的语言。');
          lastDynamicNoticeAt = Date.now();
        }
      }
      lastMissingSignature = signature;
    }, 320);
